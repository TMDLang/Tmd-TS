{
  "name": "tmdlang",
  "version": "0.2.2",
  "description": "TypeScript parser, AST, CLI, and multi-format music generator for TMD (Timebase Mark Down)",
  "author": "zonble",
  "license": "MIT",
  "homepage": "https://tmdlang.github.io/Tmd-TS/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMDLang/Tmd-TS.git"
  },
  "bugs": {
    "url": "https://github.com/TMDLang/Tmd-TS/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tmd": "bin/tmd.js",
    "tmdlang": "bin/tmd.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "eslint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jszip": "^3.10.1",
    "zod": "^4.5.4"
  }
}
