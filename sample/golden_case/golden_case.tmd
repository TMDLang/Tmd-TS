/* =========================================================================
   TempoAbyss 段（極限低速深淵 — 測試 BPM 合法下界 10 BPM 與微觀細分）
   - 測試極低速：{!= 24} -> {!= 16} -> {!= 12} -> {!= 10.5} -> {!= 10}（精準踩在 TMD 規範 [10, 1000] BPM 的合法下限邊界！）
   - 在極低 BPM 下搭配 <16*> 與 <32*> 高密度微觀音群，測試時間軸精細度，同時避免單小節過長。
   ========================================================================= */

TempoAbyss:Piano@|0| {
    <16*>
    {<2/4>}
    /* 第 1 小節：從 24 BPM 減速至 16 BPM */
    | {!= 24} {pp} 6_ 1 3 6 {!= 16} 5'_ 7_ 2 5' |
    /* 第 2 小節：下探至 12 BPM、10.5 BPM 與規範下界極限 10 BPM，切入 <32*> 碎音 */
    <32*>
    | {!= 12} {p} 4_ 6_ 1 4' 3 2' {!= 10.5} {mp} 6_ 7_ 1 2' 3 6 {!= 10} {ff} 6^ 6'_ 6_ 0 |
    <16*>
    {<4/4>}
}

TempoAbyss:Cello@|0| {
    <16*>
    {<2/4>}
    | {!= 24} {pp} 6__ - 3__ - {!= 16} 5'__ - 2__ - |
    | {!= 12} {p} 4__ - 1__ {!= 10.5} {mp} 3__ - - {!= 10} {ff} 6__ 0 |
    {<4/4>}
}

TempoAbyss:TubularBells@|0| {
    <16*>
    {<2/4>}
    | {!= 24} {pp} 6 - 0 0 {!= 16} 5' - 0 0 |
    | {!= 12} {p} 4 - 0 {!= 10.5} {mp} 3 - 0 {!= 10} {ff} 6_ 0 |
    {<4/4>}
}

/* =========================================================================
   TempoHyper 段（極限超音速風暴 — 測試 BPM 合法上界 1000 BPM 與連續加速 {!+ ...}）
   - 測試極高速：{!= 240} -> {!+ 120} (360 BPM) -> {!+ 120} (480 BPM) -> {!= 600} -> {!= 720} -> {!= 840} -> {!= 999.9} -> {!= 1000}
   - 8 小節在超高速下一閃而過，精準踩滿 TMD 規範 [10, 1000] BPM 的合法上限邊界 1000 BPM！
   ========================================================================= */

TempoHyper:Piano@|0| {
    <8*>
    {<4/4>}
    | {!= 240} {mp} 6_ 1 3 6 5' 6 3 1 | {!+ 120} {mf} 7_ 2 5' 7 6 7 5' 2 |
    | {!+ 120} {f} 1 3 6 1^ 7 1^ 6 3 | {!= 600} 2' 4' 6 2'^ 1^ 7 6 5' |
    | {!= 720} {ff} 3^ 2'^ 3^ 5'^ 6^ 5'^ 3^ 1^ | {!= 840} 7 2^ 5'^ 7^ 6^ 5'^ 4'^ 3^ |
    | {!= 999.9} 6^ 5'^ 6^ 1^^ 7^ 6^ 5'^ 3^ | {!= 1000} 6^ 3^ 1^ 6 6'^ 6^ 0 0 |
}

TempoHyper:Xylophone@|0| {
    <8*>
    {<4/4>}
    | {!= 240} {mp} 6 1^ 3^ 6^ 5'^ 6^ 3^ 1^ | {!+ 120} {mf} 7 2^ 5'^ 7^ 6^ 7^ 5'^ 2^ |
    | {!+ 120} {f} 1^ 3^ 6^ 1^^ 7^ 1^^ 6^ 3^ | {!= 600} 2'^ 4'^ 6^ 2'^^ 1^^ 7^ 6^ 5'^ |
    | {!= 720} {ff} 3^^ 2'^^ 3^^ 5'^^ 6^^ 5'^^ 3^^ 1^^ | {!= 840} 7^ 2^^ 5'^^ 7^^ 6^^ 5'^^ 4'^^ 3^^ |
    | {!= 999.9} 6^^ 5'^^ 6^^ 1^^^ 7^^ 6^^ 5'^^ 3^^ | {!= 1000} 6^^ 3^^ 1^^ 6^ 6'^^ 6^^ 0 0 |
}

TempoHyper:Strings@|0| {
    <4*>
    {<4/4>}
    | {!= 240} {mp} 6 - 3 - | {!+ 120} {mf} 5' - 7 - |
    | {!+ 120} {f} 1^ - 6 - | {!= 600} 2'^ - 7 - |
    | {!= 720} {ff} 3^ - 6^ - | {!= 840} 5'^ - 3^ - |
    | {!= 999.9} 6^ 3^ 1^ 6 | {!= 1000} 6^ 6'^ 6^ 0 |
}

