    <4*>
    {<4/4>}
    | {!= 240} {mp} 6__ 0 3__ 0 | {!+ 120} {mf} 5'__ 0 2__ 0 |
    | {!+ 120} {f} 6__ 0 1_ 0 | {!= 600} 2'__ 0 3__ 0 |
    | {!= 720} {ff} 6__ 6__ 3__ 3__ | {!= 840} 5'__ 5'__ 3__ 3__ |
    | {!= 999.9} 6__ 3__ 1__ 6___ | {!= 1000} 6__ 6'__ 6__ 0 |
